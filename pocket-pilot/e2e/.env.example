# Exemple réservé au runner Playwright. Ne placez jamais ces valeurs dans
# l’environnement de production ou dans une variable NEXT_PUBLIC_*.
E2E_BASE_URL=http://127.0.0.1:3000
E2E_SUPABASE_URL=http://127.0.0.1:54321
E2E_SUPABASE_PUBLISHABLE_KEY=your-local-anon-or-publishable-key
E2E_SUPABASE_SERVICE_ROLE_KEY=your-local-or-test-service-role-key

# Garde-fou obligatoire après vérification de la cible Supabase.
E2E_CONFIRM_NON_PRODUCTION=true

# Obligatoire pour tester réellement la confirmation et la récupération email.
E2E_MAILPIT_URL=http://127.0.0.1:54324
