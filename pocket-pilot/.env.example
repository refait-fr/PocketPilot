# Origine publique exacte de l’application, sans chemin ni slash final.
# HTTP est accepté uniquement pour localhost en développement.
SITE_URL=http://localhost:3000

# URL publique du projet Supabase ciblé par cet environnement.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Clé publique navigateur. Ne jamais la remplacer par une clé secret/service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Clé service_role Supabase, SERVEUR UNIQUEMENT (jamais de préfixe NEXT_PUBLIC).
# Requise pour l’API Raccourci iOS (POST /api/transactions via jeton personnel).
# Sans elle, la route répond 500. À définir aussi dans le dashboard Vercel.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-service-role-key

# OBLIGATOIRE avant toute ouverture publique : identité légale affichée sur
# /privacy. Tant qu'elle est vide, la page affiche un bandeau bloquant.
PRIVACY_CONTROLLER_NAME=

# OBLIGATOIRE avant toute ouverture publique : adresse dédiée aux demandes
# relatives aux données personnelles. Un format invalide vaut absence.
PRIVACY_CONTACT_EMAIL=privacy@example.com
